    private void CheckForWinAndShowPopup()
    {
        // 1. Kiểm tra điều kiện bắt buộc
        if (SelectedReward == null)
        {
            JSRuntime.InvokeVoidAsync("showCustomError", "Chưa chọn giải thưởng ?");
            return;
        }

        // 2. Phân tích và chuẩn hóa số nhập vào
        // Chúng ta tạo một List<int> các số hợp lệ đã được nhập
        var parsedValidNumbers = new List<int>();

        // Lấy các chuỗi số từ InputNumbers, làm sạch và cố gắng chuyển đổi
        var inputNumberStrings = InputNumbers
            .Split(new char[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim())
            .ToList();

        foreach (var s in inputNumberStrings)
        {
            if (int.TryParse(s, out int n))
            {
                parsedValidNumbers.Add(n);
            }
        }

        // 3. LOGIC KIỂM TRA CHÚNG THƯỞNG MỚI:

        // Điều kiện A: Phải nhập ĐỦ 4 số (và là 4 số hợp lệ)
        bool hasRequiredCount = parsedValidNumbers.Count == 4 || parsedValidNumbers.Count == 5; 

        // Điều kiện B: TẤT CẢ 4 số hợp lệ đó phải có trong CurrentSelectedNumbers (ô 70%)
        bool allNumbersMatch = hasRequiredCount &&
                               parsedValidNumbers.All(n => CurrentSelectedNumbers.Contains(n));

        // Điều kiện C: Không được có số nhập vào không hợp lệ (ví dụ: "01, 15, ABC, 7")
        // Kiểm tra số lượng chuỗi đã nhập có khớp với số lượng số hợp lệ không
        bool allInputsValid = inputNumberStrings.Count == parsedValidNumbers.Count;

        // 4. Kiểm tra điều kiện cuối cùng
        bool isWinner = hasRequiredCount && allNumbersMatch && allInputsValid;

        // Tạo khóa chuẩn hóa (Chỉ cần tạo một lần)
        string winningKey = string.Join("-", parsedValidNumbers.OrderBy(n => n));

        // 💥 BỔ SUNG: Biến theo dõi lỗi trùng lặp 💥
        bool isDuplicate = false;

        // 5. Kiểm tra Trùng lặp (Chỉ khi đã thắng)
        if (isWinner)
        {
            if (UsedWinningCombinations.Contains(winningKey))
            {
                // Trùng lặp!
                isWinner = false; // Đặt lại cờ thắng
                isDuplicate = true; // Đặt cờ trùng lặp
                JSRuntime.InvokeVoidAsync("showCustomError", $"Bộ 4 hoặc 5 số ({winningKey}) này đã được sử dụng để nhận thưởng trước đó. Vui lòng kiểm tra lại.");
            }
        }

        if (isWinner)
        {
            // 6. Thỏa mãn điều kiện trúng thưởng, mở popup
            isPopupVisible = true;
        }
        else
        {
            // 7. Hiển thị thông báo lỗi (Chỉ khi KHÔNG phải lỗi trùng lặp)
            if (!isDuplicate)
            {
                string alertMessage;
                if (!allInputsValid) { alertMessage = "Dãy số nhập vào có chứa ký tự không phải là số hoặc định dạng không đúng. Vui lòng kiểm tra lại."; }
                else if (!hasRequiredCount) { alertMessage = $"Dãy số phải có ĐỦ 4 hoặc 5 số. Hiện tại bạn đã nhập {parsedValidNumbers.Count} số."; }
                else { alertMessage = "Tất cả 4 hoặc 5 số nhập vào phải khớp với các số đã quay . Không đủ điều kiện trúng thưởng."; }

                JSRuntime.InvokeVoidAsync("showCustomError", alertMessage);
            }
        }

        StateHasChanged();
    }
    private async Task HandleCaptureCompleteFromPopup(string base64Image)
    {
        // 1. Gửi chuỗi ảnh Base64 về component cha (Index.razor)
        await OnDrawComplete.InvokeAsync(base64Image);

        // 2. PHÂN TÍCH SỐ NHẬP VÀO (Cần thiết cho cả tên file và logic UsedWinningCombinations)
        var parsedNumbers = ParseInputNumbers()
                            .Select(s => int.TryParse(s, out int n) ? (int?)n : null)
                            .Where(n => n.HasValue)
                            .Select(n => n.Value)
                            .ToList();

        // 3. LOGIC XỬ LÝ KHI CÓ ẢNH THƯỞNG ĐƯỢC CHỌN
        if (SelectedReward != null)
        {
            // 3.1. Tạo Winning Key và Lưu vào Lịch sử (Chỉ khi đủ 4 số)
            if (parsedNumbers.Count == 4 || parsedNumbers.Count == 5)
            {
                // Tạo khóa chuẩn hóa (sắp xếp và nối lại)
                string winningKey = string.Join("-", parsedNumbers.OrderBy(n => n));

                // 💥 BỔ SUNG LOGIC LƯU LỊCH SỬ BỘ SỐ 💥
                UsedWinningCombinations.Add(winningKey);
            }

            // 3.2. Tạo Tên File và Tải xuống
            string rewardName = SelectedReward.Name ?? $"Reward_{SelectedReward.Id}";
            string numbersString = string.Join("-", parsedNumbers.OrderBy(n => n).Select(n => n.ToString("D2")));
            string fileName = $"{rewardName}_{numbersString}.png";

            // Gọi hàm JS để tải ảnh xuống
            await JSRuntime.InvokeVoidAsync("SaveFile", fileName, base64Image);

            // 3.3. Cập nhật trạng thái ảnh thưởng (đã dùng)
            SelectedReward.IsUsed = true;
            SelectedReward.IsSelected = false;
            SelectedReward = null;
        }
        // ----------------------------------------------------

        // 4. Tắt Popup (Logic này đã đúng)
        isPopupVisible = false;

        // 5. Kiểm tra và Hiển thị Popup Tổng thể
        bool allRewardsUsed = RewardImages.All(r => r.IsUsed);
        if (allRewardsUsed)
        {
            isSummaryPopupVisible = true;
        }

        StateHasChanged();
    }
