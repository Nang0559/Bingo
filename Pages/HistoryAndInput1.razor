    public List<string> ParseInputNumbers()
    {
        if (string.IsNullOrWhiteSpace(InputNumbers))
        {
            return new List<string>();
        }
        return InputNumbers.Split(new char[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
                           .Select(s => s.Trim())
                           .ToList();
    }
    private void CheckAndAddWinner()
    {
        // 1. Kiểm tra điều kiện đầu vào cơ bản
        if (string.IsNullOrWhiteSpace(InputNumbers) || SelectedReward == null)
        {
            JSRuntime.InvokeVoidAsync("showCustomError", "Vui lòng chọn giải và nhập dãy số.");
            return;
        }

        // 2. Phân tích và chuẩn hóa (Giữ nguyên logic cũ của bạn)
        var parsedValidNumbers = new List<int>();
        var inputNumberStrings = InputNumbers
            .Split(new char[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim())
            .ToList();

        foreach (var s in inputNumberStrings)
        {
            if (int.TryParse(s, out int n)) parsedValidNumbers.Add(n);
        }

        // 3. LOGIC VALIDATE (Giữ nguyên logic cũ)
        bool hasRequiredCount = parsedValidNumbers.Count == 4 || parsedValidNumbers.Count == 5;
        bool allNumbersMatch = hasRequiredCount && parsedValidNumbers.All(n => CurrentSelectedNumbers.Contains(n));
        bool allInputsValid = inputNumberStrings.Count == parsedValidNumbers.Count;
        bool isWinner = hasRequiredCount && allNumbersMatch && allInputsValid;

        if (!isWinner)
        {
            // Xử lý lỗi như cũ
            string alertMessage;
            if (!allInputsValid) alertMessage = "Dãy số chứa ký tự không hợp lệ.";
            else if (!hasRequiredCount) alertMessage = $"Yêu cầu 4 hoặc 5 số. Bạn nhập {parsedValidNumbers.Count}.";
            else alertMessage = "Các số nhập vào không khớp với kết quả quay.";

            JSRuntime.InvokeVoidAsync("showCustomError", alertMessage);
            return; // Dừng lại nếu không trúng
        }

        // 4. Tạo khóa chuẩn hóa
        string winningKey = string.Join("-", parsedValidNumbers.OrderBy(n => n));

        // 5. KIỂM TRA TRÙNG LẶP (Logic quan trọng mới)

        // A. Kiểm tra xem đã trao giải này trong quá khứ chưa
        if (UsedWinningCombinations.Contains(winningKey))
        {
            JSRuntime.InvokeVoidAsync("showCustomError", $"Bộ số ({winningKey}) này ĐÃ ĐƯỢC trao thưởng trước đó.");
            return;
        }

        // B. Kiểm tra xem vừa mới thêm vào danh sách tạm thời chưa (tránh click 2 lần hoặc nhập lại)
        if (_tempSessionWinners.Contains(winningKey))
        {
            JSRuntime.InvokeVoidAsync("showCustomError", $"Bộ số ({winningKey}) này vừa được thêm vào danh sách chờ.");
            return;
        }

        // 6. THÀNH CÔNG: Thêm vào danh sách tạm
        _tempSessionWinners.Add(winningKey);
        _tempSessionWinnersDisplay.Add(string.Join(", ", parsedValidNumbers)); // Để hiển thị UI

        // Reset ô nhập liệu để nhập người tiếp theo
        InputNumbers = string.Empty;

        // Thông báo nhẹ (Toast) thay vì Popup lỗi
        JSRuntime.InvokeVoidAsync("console.log", "Đã thêm bộ số trúng thưởng: " + winningKey);

        StateHasChanged();
    }
