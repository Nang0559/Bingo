@implements IDisposable

@if (IsVisible && _draft != null)
{
    <div class="settings-overlay">
        <div class="settings-modal">

            <div class="settings-header">
                <h4>⚙️ Cài đặt</h4>
                <button class="close-btn" @onclick="Cancel">×</button>
            </div>

            <div class="settings-body">

                @if (_error != null)
                {
                    <div class="alert alert-danger py-2">@_error</div>
                }

                @* ============ CHUNG ============ *@
                <h5 class="settings-section">Chung</h5>

                <div class="mb-2">
                    <label class="form-label">Tên chương trình</label>
                    <input type="text" class="form-control" maxlength="60" @bind="_draft.Title" @bind:event="oninput" />
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-6 col-md-3">
                        <label class="form-label">Tổng số bóng</label>
                        <input type="number" class="form-control" min="20" max="99"
                               @bind="_draft.TotalNumbers" disabled="@(TotalLocked || CardsLocked)" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label">Số trúng tối thiểu</label>
                        <input type="number" class="form-control" min="1" max="15" @bind="_draft.MinWinCount" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label">Số trúng tối đa</label>
                        <input type="number" class="form-control" min="1" max="15" @bind="_draft.MaxWinCount" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label">Pháo hoa (giây)</label>
                        <input type="number" class="form-control" min="1" max="60" @bind="_draft.ConfettiSeconds" />
                    </div>
                </div>
                @if (TotalLocked)
                {
                    <div class="form-text mb-2">Không đổi được "Tổng số bóng" khi ván đang chơi. Hãy bấm "Ván mới" trước.</div>
                }
                else if (CardsLocked)
                {
                    <div class="form-text mb-2">Không đổi được "Tổng số bóng" vì bộ thẻ đã phát hành (xem mục Thẻ Bingo bên dưới).</div>
                }

                @* ============ MÀU BÓNG ============ *@
                <h5 class="settings-section">Màu bóng</h5>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <input type="color" class="form-control form-control-color" title="Chọn màu bóng"
                           value="@_draft.BallColor" @onchange="OnBallColorChanged" />
                    @foreach (var c in BallPresets)
                    {
                        var color = c;
                        <button type="button" class="ball-swatch @(_draft.BallColor == color ? "active" : "")"
                                style="background:@color" title="@color" @onclick="() => _draft.BallColor = color"></button>
                    }
                    <span class="ball-preview" style="@AppSettings.BuildBallVars(_draft.BallColor)">07</span>
                </div>

                @* ============ THẺ BINGO ============ *@
                <h5 class="settings-section">Thẻ Bingo 5×5 (in 8 thẻ / tờ A4)</h5>

                @if (CardsLocked)
                {
                    <div class="alert alert-warning py-2 mb-2">
                        🔒 <strong>Bộ thẻ đã phát hành</strong>@(Cards.IssuedAt != null ? $" ({Cards.IssuedAt})" : "")
                        — @Cards.Count thẻ. Các thẻ đã in được giữ nguyên: bạn chỉ có thể <strong>tăng số người</strong>
                        (thẻ mới nối thêm phía sau). Muốn đổi số thẻ / người hoặc tổng số bóng, hãy bấm "Tạo bộ thẻ mới".
                    </div>
                }

                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label">Số người tham gia</label>
                        <input type="number" class="form-control" min="@(CardsLocked ? Cards.Count / Math.Max(1, Cards.SetPerPerson) : 0)" max="@CardService.MaxParticipants"
                               @bind="_draft.Participants" @bind:event="oninput" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Thẻ / người</label>
                        <input type="number" class="form-control" min="1" max="10" disabled="@CardsLocked"
                               @bind="_draft.CardsPerPerson" @bind:event="oninput" />
                    </div>
                </div>
                <div class="form-text mb-2">
                    Tổng thẻ phát hành: <strong>@_draft.CardsIssued</strong>
                    · Số tờ A4: <strong>@((_draft.CardsIssued + CardService.CardsPerSheet - 1) / CardService.CardsPerSheet)</strong>.
                    Mỗi thẻ là bảng <strong>5×5</strong> (cột B-I-N-G-O, ô giữa <strong>FREE</strong>); thẻ trúng khi đủ
                    <strong>1 hàng, 1 cột hoặc 1 đường chéo</strong>. Đặt số người = 0 để không dùng thẻ.
                    @if (_draft.TotalNumbers >= CardService.MinTotalForCards)
                    {
                        <div>Dải số theo cột: @CardService.RangeText(_draft.TotalNumbers)</div>
                    }
                    else if (_draft.CardsIssued > 0)
                    {
                        <div class="text-danger">Cần tổng số bóng từ @CardService.MinTotalForCards trở lên để phát hành thẻ 5×5.</div>
                    }
                </div>

                @* ---- Danh sách thẻ trên màn hình quay số ---- *@
                <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" id="settings-show-card-list" @bind="_draft.ShowCardList" />
                        <label class="form-check-label" for="settings-show-card-list">Hiện danh sách thẻ Đã Bingo / Chờ 1 / Chờ 2</label>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-grow-1" style="min-width:220px">
                        <span class="small text-nowrap">Độ đậm nền: <strong>@((int)Math.Round(_draft.CardListOpacity * 100))%</strong></span>
                        <input type="range" class="form-range" min="0.1" max="1" step="0.05" disabled="@(!_draft.ShowCardList)"
                               @bind="_draft.CardListOpacity" @bind:event="oninput" />
                    </div>
                </div>
                <div class="form-text mb-2">Danh sách mặc định nằm mờ ở góc phải phía dưới khu quay số; kéo tiêu đề để đặt vào vị trí tùy ý (được ghi nhớ), bấm đúp tiêu đề để về chỗ cũ, rê chuột vào là hiện rõ, bấm tiêu đề để thu gọn.</div>

                @* ---- Xem trước ---- *@
                @if (_draft.CardsIssued > 0)
                {
                    var preview = Cards.Preview(_draft, _previewCount);
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <strong>Xem trước thẻ</strong>
                        <span class="text-muted small">(@preview.Count / @_draft.CardsIssued thẻ đầu tiên)</span>
                        @if (!CardsLocked)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm ms-auto" @onclick="Reshuffle">🎲 Bộ số khác</button>
                        }
                    </div>
                    <div class="pv-grid">
                        @foreach (var c in preview)
                        {
                            <div class="pv-card" style="@AppSettings.BuildBallVars(_draft.BallColor)">
                                <div class="pv-head"><span class="pv-title">@_draft.Title</span><span class="pv-code">@c.Code</span></div>
                                <div class="pv-who">@c.Who</div>
                                <div class="pv-board">
                                    @foreach (var ch in CardService.Letters)
                                    {
                                        <div class="pv-l">@ch</div>
                                    }
                                    @for (int cell = 0; cell < c.Numbers.Length; cell++)
                                    {
                                        if (cell == CardService.FreeCell)
                                        {
                                            <div class="pv-f">FREE</div>
                                        }
                                        else
                                        {
                                            <div class="pv-n">@c.Numbers[cell].ToString("00")</div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    @if (_previewCount < Math.Min(_draft.CardsIssued, 24))
                    {
                        <button type="button" class="btn btn-link btn-sm p-0 mb-2" @onclick="() => _previewCount += 4">Xem thêm</button>
                    }
                    @if (!CardsLocked)
                    {
                        <div class="form-text mb-2">Thẻ hiển thị ở đây chính là thẻ sẽ được tạo khi bấm Lưu. Sau khi in, bộ thẻ tự khóa.</div>
                    }
                }

                @* ---- In / khóa / sao lưu ---- *@
                <div class="card-tools">
                    @if (Cards.HasCards)
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <span class="small">In từ thẻ</span>
                            <input type="number" class="form-control form-control-sm" style="width:84px" min="1" max="@Cards.Count" @bind="_printFrom" />
                            <span class="small">đến</span>
                            <input type="number" class="form-control form-control-sm" style="width:84px" min="1" max="@Cards.Count" @bind="_printTo" />
                            <button type="button" class="btn btn-success btn-sm" disabled="@(!CardsSaved)" @onclick="PrintCards">🖨️ In thẻ</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => { _printFrom = 1; _printTo = Cards.Count; }">Tất cả</button>
                        </div>
                        @if (!CardsSaved)
                        {
                            <div class="form-text text-danger mb-2">Thiết lập thẻ đã đổi: bấm 💾 Lưu rồi mới in.</div>
                        }
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            @if (!Cards.Issued)
                            {
                                <button type="button" class="btn btn-outline-warning btn-sm" disabled="@(!CardsSaved)" @onclick="LockCards">🔒 Khóa bộ thẻ</button>
                            }
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ExportCards">⬇ Sao lưu bộ thẻ</button>
                            @if (Cards.Issued)
                            {
                                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="DiscardCards">🗑 Tạo bộ thẻ mới</button>
                            }
                        </div>
                    }
                    <label class="btn btn-outline-secondary btn-sm mb-2">
                        ⬆ Khôi phục bộ thẻ từ file
                        <input type="file" accept=".json,application/json" hidden id="settings-cards-import" @onchange="ImportCards" />
                    </label>
                    <div class="form-text mb-2">Nên sao lưu bộ thẻ sau khi in: dữ liệu thẻ chỉ lưu trong trình duyệt này.</div>
                </div>

                @* ============ HÌNH NỀN ============ *@
                <h5 class="settings-section">Hình nền</h5>

                <div class="settings-bg-preview" style="@AppSettings.BuildBackgroundStyle(_draft.BackgroundImage, _draft.BackgroundOverlay)">
                    <span class="settings-bg-preview-label">Xem trước</span>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-2">
                    <label class="btn btn-outline-primary btn-sm mb-0">
                        📁 Chọn ảnh nền
                        <input type="file" accept="image/*" hidden id="settings-bg-file" @onchange="OnBackgroundSelected" />
                    </label>
                    <button class="btn btn-outline-secondary btn-sm"
                            @onclick="() => _draft.BackgroundImage = AppSettings.DefaultBackground">
                        Ảnh mặc định
                    </button>
                    <button class="btn btn-outline-secondary btn-sm"
                            @onclick="() => _draft.BackgroundImage = null">
                        Không dùng ảnh nền
                    </button>
                </div>

                <label class="form-label mt-2">
                    Độ mờ ảnh nền: <strong>@((int)Math.Round(_draft.BackgroundOverlay * 100))%</strong>
                </label>
                <input type="range" class="form-range" min="0" max="1" step="0.05"
                       @bind="_draft.BackgroundOverlay" @bind:event="oninput" />

                @* ============ PHẦN THƯỞNG ============ *@
                <h5 class="settings-section">Phần thưởng</h5>
                <div class="form-text mb-2">Thứ tự ở đây là thứ tự hiển thị trong màn hình quay thưởng.</div>

                @for (int i = 0; i < _draft.Rewards.Count; i++)
                {
                    var index = i;
                    var reward = _draft.Rewards[i];
                    <div class="settings-reward-row" @key="reward.Id">
                        <img src="@reward.ImagePath" class="settings-reward-thumb" alt="@reward.Name" />

                        <input type="text" class="form-control form-control-sm" maxlength="40"
                               placeholder="Tên giải" @bind="reward.Name" @bind:event="oninput" />

                        <label class="btn btn-outline-primary btn-sm mb-0 text-nowrap">
                            📁 Ảnh
                            <input type="file" accept="image/*" hidden
                                   id="@($"settings-reward-file-{reward.Id}")"
                                   @onchange="() => OnRewardImageSelected(reward)" />
                        </label>

                        <button class="btn btn-outline-secondary btn-sm" title="Lên"
                                disabled="@(index == 0)" @onclick="() => MoveReward(index, -1)">▲</button>
                        <button class="btn btn-outline-secondary btn-sm" title="Xuống"
                                disabled="@(index == _draft.Rewards.Count - 1)" @onclick="() => MoveReward(index, 1)">▼</button>
                        <button class="btn btn-outline-danger btn-sm" title="Xóa giải"
                                disabled="@(_draft.Rewards.Count <= 1)" @onclick="() => RemoveReward(index)">✕</button>
                    </div>
                }

                <button class="btn btn-outline-success btn-sm mt-2" @onclick="AddReward">＋ Thêm giải thưởng</button>
            </div>

            <div class="settings-footer">
                <div class="d-flex flex-wrap gap-2 me-auto">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ExportSettings">⬇ Xuất file</button>
                    <label class="btn btn-outline-secondary btn-sm mb-0">
                        ⬆ Nhập file
                        <input type="file" accept=".json,application/json" hidden id="settings-import-file" @onchange="ImportSettings" />
                    </label>
                    <button class="btn btn-outline-danger btn-sm" @onclick="RestoreDefaults">Khôi phục mặc định</button>
                </div>
                <button class="btn btn-secondary" @onclick="Cancel">Hủy</button>
                <button class="btn btn-success" @onclick="Save">💾 Lưu</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }

    /// <summary>true khi ván đang chơi: khóa ô "Tổng số bóng".</summary>
    [Parameter] public bool TotalLocked { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private static readonly string[] BallPresets =
        { "#28a745", "#dc3545", "#0d6efd", "#fd7e14", "#6f42c1", "#e83e8c", "#20c997", "#ffc107" };

    private void OnBallColorChanged(ChangeEventArgs e) =>
        _draft!.BallColor = AppSettings.NormalizeColor(e.Value?.ToString());

    private AppSettings? _draft;
    private string? _error;
    private bool _wasVisible;

    private int _previewCount = 4;
    private int _printFrom = 1;
    private int _printTo = 1;

    /// <summary>Bộ thẻ đã phát hành (in/khóa) → không cho đổi thông số làm hỏng thẻ đã in.</summary>
    private bool CardsLocked => Cards.HasCards && Cards.Issued;

    /// <summary>Thiết lập thẻ đang chỉnh đã khớp với bộ thẻ đã lưu (mới được in).</summary>
    private bool CardsSaved => _draft != null && Cards.HasCards
        && _draft.TotalNumbers == Cards.SetTotal
        && _draft.CardsIssued == Cards.Count;

    protected override void OnInitialized() => Cards.OnChange += HandleCardsChanged;

    public void Dispose() => Cards.OnChange -= HandleCardsChanged;

    private void HandleCardsChanged() => InvokeAsync(StateHasChanged);

    protected override void OnParametersSet()
    {
        // Mỗi lần mở popup: làm việc trên bản sao, chỉ áp dụng khi bấm Lưu
        if (IsVisible && !_wasVisible)
        {
            _draft = SettingsService.Clone(Settings.Current);
            _error = null;
            _previewCount = 4;
            _printFrom = 1;
            _printTo = Math.Max(1, Cards.Count);
            Cards.ResetPending();
        }
        _wasVisible = IsVisible;
    }

    private void Reshuffle() => Cards.ReshufflePending();

    private async Task PrintCards()
    {
        if (_draft == null || !CardsSaved) return;
        int from = Math.Clamp(_printFrom, 1, Cards.Count);
        int to = Math.Clamp(_printTo, from, Cards.Count);
        await Cards.PrintAsync(Settings.Current, from, to); // in xong tự khóa bộ thẻ
    }

    private async Task LockCards() => await Cards.LockAsync();

    private async Task DiscardCards()
    {
        var ok = await JSRuntime.InvokeAsync<bool>("confirm",
            "Tạo bộ thẻ mới?\nBộ thẻ hiện tại (đã phát hành) sẽ bị XÓA. Các thẻ đã in sẽ không còn dùng được.");
        if (!ok) return;
        await Cards.DiscardAsync();
        _error = null;
    }

    private async Task ExportCards()
    {
        var json = Cards.ExportJson();
        if (json == null) return;
        var dataUrl = "data:application/json;charset=utf-8," + Uri.EscapeDataString(json);
        await JSRuntime.InvokeVoidAsync("SaveFile", $"bingo-cards-{DateTime.Now:yyyyMMdd-HHmm}.json", dataUrl);
    }

    private async Task ImportCards()
    {
        var text = await JSRuntime.InvokeAsync<string?>("SettingsHelper.readText", "settings-cards-import");
        if (text == null) return;

        if (Cards.HasCards)
        {
            var ok = await JSRuntime.InvokeAsync<bool>("confirm",
                "Khôi phục bộ thẻ từ file sẽ THAY THẾ bộ thẻ hiện tại. Tiếp tục?");
            if (!ok) return;
        }

        var err = await Cards.ImportAsync(text);
        if (err != null) { _error = err; return; }

        _draft = SettingsService.Clone(Settings.Current);
        _printFrom = 1;
        _printTo = Cards.Count;
        _error = null;
    }

    private async Task Cancel() => await OnClose.InvokeAsync();

    private async Task Save()
    {
        if (_draft == null) return;

        _error = Validate(_draft);
        if (_error != null) return;

        var saved = await Settings.SaveAsync(_draft);
        if (!saved)
        {
            await JSRuntime.InvokeVoidAsync("showCustomError",
                "Không lưu được vào trình duyệt (có thể ảnh quá lớn hoặc đang ở chế độ ẩn danh). " +
                "Thiết lập vẫn áp dụng cho phiên này nhưng sẽ mất khi tải lại trang.",
                "Cảnh báo");
        }
        await OnClose.InvokeAsync();
    }

    private string? Validate(AppSettings s)
    {
        if (string.IsNullOrWhiteSpace(s.Title)) return "Vui lòng nhập tên chương trình.";
        if (s.TotalNumbers < 20 || s.TotalNumbers > 99) return "Tổng số bóng phải từ 20 đến 99.";
        if (s.MinWinCount < 1 || s.MaxWinCount > 15) return "Số trúng phải từ 1 đến 15.";
        if (s.MinWinCount > s.MaxWinCount) return "Số trúng tối thiểu không được lớn hơn tối đa.";
        if (s.MaxWinCount > s.TotalNumbers) return "Số trúng tối đa không được lớn hơn tổng số bóng.";
        if (s.Participants < 0 || s.Participants > CardService.MaxParticipants)
            return $"Số người tham gia phải từ 0 đến {CardService.MaxParticipants}.";
        if (s.CardsPerPerson < 1 || s.CardsPerPerson > 10) return "Số thẻ mỗi người phải từ 1 đến 10.";
        if (s.CardsIssued > 0)
        {
            if (s.TotalNumbers < CardService.MinTotalForCards)
                return $"Thẻ Bingo 5×5 cần tổng số bóng từ {CardService.MinTotalForCards} trở lên (mỗi cột B-I-N-G-O cần ít nhất 5 số).";
        }
        if (CardsLocked)
        {
            if (s.TotalNumbers != Cards.SetTotal || s.CardsPerPerson != Cards.SetPerPerson)
                return "Bộ thẻ đã phát hành: không đổi được Tổng số bóng, Thẻ / người. Bấm \"Tạo bộ thẻ mới\" nếu muốn đổi.";
            if (s.CardsIssued < Cards.Count)
                return $"Bộ thẻ đã phát hành ({Cards.Count} thẻ): không được giảm số người. Bấm \"Tạo bộ thẻ mới\" nếu muốn làm lại.";
        }
        if (s.ConfettiSeconds < 1 || s.ConfettiSeconds > 60) return "Thời gian pháo hoa phải từ 1 đến 60 giây.";
        if (s.Rewards.Count == 0) return "Cần ít nhất 1 giải thưởng.";
        if (s.Rewards.Any(r => string.IsNullOrWhiteSpace(r.Name))) return "Mỗi giải thưởng cần có tên.";
        return null;
    }

    // ---------- Hình nền ----------
    private async Task OnBackgroundSelected()
    {
        var data = await JSRuntime.InvokeAsync<string?>("SettingsHelper.pickImage", "settings-bg-file", 1600, "image/jpeg", 0.82);
        if (data != null) _draft!.BackgroundImage = data;
    }

    // ---------- Phần thưởng ----------
    private async Task OnRewardImageSelected(RewardSetting reward)
    {
        var data = await JSRuntime.InvokeAsync<string?>("SettingsHelper.pickImage", $"settings-reward-file-{reward.Id}", 500, "auto", 0.9);
        if (data != null) reward.ImagePath = data;
    }

    private void AddReward()
    {
        var id = _draft!.Rewards.Count == 0 ? 1 : _draft.Rewards.Max(r => r.Id) + 1;
        _draft.Rewards.Add(new RewardSetting
        {
            Id = id,
            Name = $"Giải {_draft.Rewards.Count + 1}",
            ImagePath = $"images/reward{((id - 1) % 5) + 1}.png"
        });
    }

    private void RemoveReward(int index)
    {
        if (_draft!.Rewards.Count > 1) _draft.Rewards.RemoveAt(index);
    }

    private void MoveReward(int index, int delta)
    {
        var list = _draft!.Rewards;
        var target = index + delta;
        if (target < 0 || target >= list.Count) return;
        (list[index], list[target]) = (list[target], list[index]);
    }

    // ---------- Xuất / nhập / mặc định ----------
    private async Task ExportSettings()
    {
        var json = SettingsService.Export(_draft!);
        var dataUrl = "data:application/json;charset=utf-8," + Uri.EscapeDataString(json);
        await JSRuntime.InvokeVoidAsync("SaveFile", "bingo-settings.json", dataUrl);
    }

    private async Task ImportSettings()
    {
        var text = await JSRuntime.InvokeAsync<string?>("SettingsHelper.readText", "settings-import-file");
        if (text == null) return;

        var imported = SettingsService.TryImport(text);
        if (imported == null)
        {
            _error = "File thiết lập không hợp lệ.";
            return;
        }
        _draft = imported;
        _error = null;
    }

    private void RestoreDefaults()
    {
        _draft = AppSettings.CreateDefault();
        _error = null;
    }
}
