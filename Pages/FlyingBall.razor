@using System.Globalization

@if (IsFlying)
{
    <div id="@CloneId"
         class="flying-ball-clone"
         style="top: @(Px(StartTop)); left: @(Px(StartLeft));">
        @Number.ToString("00")
    </div>
}

@code {
    [Parameter] public int Number { get; set; }
    [Parameter] public float StartTop { get; set; }
    [Parameter] public float StartLeft { get; set; }
    [Parameter] public Action? OnFlyComplete { get; set; }

    private bool IsFlying = true;
    private string CloneId => $"flying-ball-clone-{Number}";

    // Luôn dùng InvariantCulture để không bị "123,5px" khi trình duyệt là vi-VN
    private static string Px(float v) => v.ToString("0.##", CultureInfo.InvariantCulture) + "px";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var target = await JSRuntime.InvokeAsync<PositionData?>(
                "AnimationHelper.getClickPosition", "flying-target-anchor");

            if (target != null)
            {
                await JSRuntime.InvokeVoidAsync("AnimationHelper.flyTo",
                    CloneId, target.left - StartLeft, target.top - StartTop);
                await Task.Delay(800);
            }
        }
        finally
        {
            // Dù có lỗi hay không vẫn phải báo hoàn thành, để số được thêm vào bảng
            IsFlying = false;
            OnFlyComplete?.Invoke();
        }
    }
}
