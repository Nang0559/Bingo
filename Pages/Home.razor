@page "/"
@implements IDisposable
@using System.Linq

<SettingsPopup IsVisible="@showSettings"
               TotalLocked="@GameStarted"
               OnClose="() => showSettings = false" />

<div class="main-container" style="@AppSettings.BuildBallVars(Settings.Current.BallColor)">

    <div class="top-area">

        <div class="spinning-area"
             style="@AppSettings.BuildBackgroundStyle(Settings.Current.BackgroundImage, Settings.Current.BackgroundOverlay)">
            <div class="game-toolbar">
                <span class="game-title">@Settings.Current.Title</span>
                <span class="game-counter">Đã quay: @CurrentSelectedNumbers.Count/@TotalNumbers</span>
            </div>

            <div id="flying-target-anchor" class="flying-anchor-point"></div>
            <SelectedNumberDisplay CurrentSelectedNumbers="CurrentSelectedNumbers" />

            @if (Cards.HasCards)
            {
                var st = Stats;
                <div class="card-stats">
                    <div class="card-stats-title">🎟️ Thẻ phát hành: <strong>@st.Total</strong>@(st.Awarded > 0 ? $" (đã trao {st.Awarded})" : "")</div>
                    <div class="card-stats-row">
                        <span class="cs-win" title="Đã đủ số, có thể nhận thưởng ngay">✅ Đủ số: <strong>@st.Winning</strong></span>
                        <span class="cs-m1" title="Còn thiếu 1 số">⏳ Thiếu 1: <strong>@st.Missing1</strong></span>
                        <span class="cs-m2" title="Còn thiếu 2 số">⌛ Thiếu 2: <strong>@st.Missing2</strong></span>
                    </div>
                    <div class="card-stats-note">
                        Có thể trúng: <strong>@st.Winning</strong> / @st.Remaining thẻ chưa trao
                        (@(st.Remaining > 0 ? (st.Winning * 100.0 / st.Remaining).ToString("0.##") : "0")%)
                    </div>
                </div>
            }
        </div>

        @if (FlyingBallData != null)
        {
            var flyNumber = FlyingBallData.Number;
            <FlyingBall Number="FlyingBallData.Number"
                        StartTop="FlyingBallData.StartTop"
                        StartLeft="FlyingBallData.StartLeft"
                        OnFlyComplete="() => OnFlyAnimationComplete(flyNumber)" />
        }

        <div class="history-area">
            <div class="control-panel">
                <QuickDrawInput OnSubmit="DrawManual" OnPreview="OnQuickPreview" />
                <button class="btn btn-primary btn-sm"
                        @onclick="DrawRandom"
                        disabled="@(FlyingBallData != null)">
                    🎲 Quay ngẫu nhiên
                </button>
                <button class="btn btn-outline-danger btn-sm"
                        @onclick="ResetGame"
                        disabled="@(FlyingBallData != null)">
                    ↺ Ván mới
                </button>
                <button class="btn btn-outline-secondary btn-sm"
                        @onclick="() => showSettings = true"
                        disabled="@(FlyingBallData != null)">
                    ⚙️ Cài đặt
                </button>
                @if (Cards.HasCards)
                {
                    <button class="btn btn-outline-success btn-sm" @onclick="PrintCards">
                        🖨️ In thẻ (@Cards.Count thẻ · @Cards.Sheets tờ A4)
                    </button>
                }
            </div>

            <HistoryAndInput @ref="historyPanel"
                             DrawnNumbers="DrawnNumbers"
                             CurrentSelectedNumbers="@CurrentSelectedNumbers"
                             OnDrawComplete="HandleDrawCompletion"
                             HistoryImages="@HistoryImages" />
        </div>
    </div>

    <div class="bottom-area">
        <NumberPanel OnNumberSelectedWithCoords="HandleNumberSelection"
                     PreviewNumber="_previewNumber"
                     DrawnNumbers="DrawnNumbers"
                     CurrentSelectedNumbers="CurrentSelectedNumbers" />
    </div>
</div>

@code {
    private int TotalNumbers => Settings.Current.TotalNumbers;
    private bool GameStarted => CurrentSelectedNumbers.Count > 0 || DrawnNumbers.Count > 0;
    private bool showSettings;

    // Thống kê thẻ dựa trên TẤT CẢ số đã quay (đang chọn + đã chốt)
    private CardStats Stats => Cards.GetStats(CurrentSelectedNumbers.Concat(DrawnNumbers));

    protected override void OnInitialized()
    {
        Settings.OnChange += HandleSettingsChanged;
        Cards.OnChange += HandleSettingsChanged;
    }

    private void HandleSettingsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Settings.OnChange -= HandleSettingsChanged;
        Cards.OnChange -= HandleSettingsChanged;
    }

    private async Task PrintCards()
    {
        // In xong bộ thẻ tự được khóa (không bị tạo lại khi đổi thiết lập)
        await Cards.PrintAsync(Settings.Current);
    }

    private List<int> CurrentSelectedNumbers { get; set; } = new();
    private HashSet<int> DrawnNumbers { get; set; } = new();
    private List<string> HistoryImages { get; set; } = new();

    // Dữ liệu quả bóng đang bay (null = không có bóng nào đang bay)
    private BallFlyData? FlyingBallData { get; set; }

    private HistoryAndInput? historyPanel;

    // ----- Nhập số thủ công (ô "Nhập số") -----
    private int? _previewNumber;
    private readonly List<int> _manualQueue = new();
    private bool _starting;

    private void OnQuickPreview(int? n)
    {
        _previewNumber = n;
        StateHasChanged();
    }

    /// <summary>Nhận số gõ tay. Trả về null nếu OK, hoặc thông báo lỗi (khi đó không số nào được nhận).</summary>
    private async Task<string?> DrawManual(IReadOnlyList<int> numbers)
    {
        var accepted = new List<int>();
        var problems = new List<string>();
        foreach (var n in numbers.Distinct())
        {
            if (n < 1 || n > TotalNumbers) problems.Add($"{n:00} ngoài khoảng 1–{TotalNumbers}");
            else if (DrawnNumbers.Contains(n) || CurrentSelectedNumbers.Contains(n)
                     || _manualQueue.Contains(n) || FlyingBallData?.Number == n)
                problems.Add($"{n:00} đã quay rồi");
            else accepted.Add(n);
        }
        if (problems.Count > 0) return string.Join("; ", problems);

        _manualQueue.AddRange(accepted);
        await StartNextManualAsync();
        return null;
    }

    // Lấy số tiếp theo trong hàng đợi và cho bóng bay (mỗi lần 1 bóng)
    private async Task StartNextManualAsync()
    {
        if (_starting || FlyingBallData != null || _manualQueue.Count == 0) return;
        _starting = true;
        try
        {
            var n = _manualQueue[0];
            _manualQueue.RemoveAt(0);
            var pos = await JSRuntime.InvokeAsync<PositionData?>("AnimationHelper.getClickPosition", $"ball-{n}");
            if (FlyingBallData != null)
            {
                _manualQueue.Insert(0, n); // có bóng khác vừa bay lên: chờ lượt sau
                return;
            }
            HandleNumberSelection(Tuple.Create(n, pos?.top ?? 0f, pos?.left ?? 0f));
        }
        finally { _starting = false; }
    }

    // Người chơi bấm vào 1 số ở bảng 75 số
    private void HandleNumberSelection(Tuple<int, float, float> data)
    {
        var (number, startTop, startLeft) = (data.Item1, data.Item2, data.Item3);

        // Đang có bóng bay thì bỏ qua, tránh bấm liên tiếp làm mất số
        if (FlyingBallData != null) return;
        if (DrawnNumbers.Contains(number) || CurrentSelectedNumbers.Contains(number)) return;

        FlyingBallData = new BallFlyData
        {
            Number = number,
            StartTop = startTop,
            StartLeft = startLeft
        };
        StateHasChanged();
    }

    // Quay ngẫu nhiên 1 số chưa ra
    private async Task DrawRandom()
    {
        if (FlyingBallData != null) return;

        var available = Enumerable.Range(1, TotalNumbers)
            .Where(n => !CurrentSelectedNumbers.Contains(n) && !DrawnNumbers.Contains(n) && !_manualQueue.Contains(n))
            .ToList();

        if (available.Count == 0)
        {
            await JSRuntime.InvokeVoidAsync("showCustomError", $"Đã quay hết {TotalNumbers} số. Hãy bắt đầu ván mới.", "Thông báo");
            return;
        }

        var number = available[Random.Shared.Next(available.Count)];
        var pos = await JSRuntime.InvokeAsync<PositionData?>("AnimationHelper.getClickPosition", $"ball-{number}");

        HandleNumberSelection(Tuple.Create(number, pos?.top ?? 0f, pos?.left ?? 0f));
    }

    // Bóng bay xong: số chính thức xuất hiện ở vùng hiển thị
    private void OnFlyAnimationComplete(int number)
    {
        if (!CurrentSelectedNumbers.Contains(number))
        {
            CurrentSelectedNumbers.Add(number);
        }

        FlyingBallData = null;
        StateHasChanged();
        _ = StartNextManualAsync(); // còn số gõ sẵn trong hàng đợi thì bay tiếp
    }

    // Sau khi trao giải + chụp ảnh xong
    private void HandleDrawCompletion(string base64Image)
    {
        if (!string.IsNullOrEmpty(base64Image))
        {
            HistoryImages.Add(base64Image);
        }

        foreach (var num in CurrentSelectedNumbers)
        {
            DrawnNumbers.Add(num);
        }

        StateHasChanged();
    }

    // Bắt đầu ván mới: xóa số đã quay, giải thưởng đã dùng và lịch sử ảnh
    private async Task ResetGame()
    {
        if (FlyingBallData != null) return;

        var ok = await JSRuntime.InvokeAsync<bool>("confirm",
            "Bắt đầu ván mới?\nToàn bộ số đã quay, giải thưởng đã trao và lịch sử ảnh sẽ bị xóa.");
        if (!ok) return;

        CurrentSelectedNumbers.Clear();
        DrawnNumbers.Clear();
        HistoryImages.Clear();
        _manualQueue.Clear();
        _previewNumber = null;
        historyPanel?.ResetState();
        StateHasChanged();
    }
}
