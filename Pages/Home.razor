@page "/"

@* Thêm các component con đã tạo ở bước trước *@
<div class="main-container">
   
    <div class="top-area">

        <div class="spinning-area">
            <div id="flying-target-anchor" class="flying-anchor-point"></div>
            <SelectedNumberDisplay CurrentSelectedNumbers="CurrentSelectedNumbers" />
        </div>

        @* 💥 HIỂN THỊ COMPONENT BÓNG BAY TẠM THỜI 💥 *@
        @if (FlyingBallData != null)
        {
            var flyNumber = FlyingBallData.Number;
            <FlyingBall Number="FlyingBallData.Number"
                        StartTop="FlyingBallData.StartTop"
                        StartLeft="FlyingBallData.StartLeft"
                        OnFlyComplete="() => OnFlyAnimationComplete(flyNumber)" />
        }

        <div class="history-area">
            <HistoryAndInput DrawnNumbers="DrawnNumbers"
                             CurrentSelectedNumbers="@CurrentSelectedNumbers"
                             OnDrawComplete="HandleDrawCompletion"
                             HistoryImages="@HistoryImages"
                             />
        </div>
    </div>

    <div class="bottom-area">
        @* 💥 CẬP NHẬT: Đổi tên EventCallback từ OnNumberSelected sang OnNumberSelectedWithCoords 💥 *@
        <NumberPanel OnNumberSelectedWithCoords="HandleNumberSelection"
                     DrawnNumbers="DrawnNumbers"
                     CurrentSelectedNumbers="CurrentSelectedNumbers" />
    </div>
</div>

@code {



    private List<int> CurrentSelectedNumbers { get; set; } = new List<int>();
    private HashSet<int> DrawnNumbers { get; set; } = new HashSet<int>();
    private List<string> HistoryImages { get; set; } = new List<string>();
    private bool isPopupVisible = false;
    // Biến trạng thái giữ dữ liệu của quả bóng đang bay
    private BallFlyData FlyingBallData { get; set; } = null;

    // 💥 2. CẬP NHẬT: HandleNumberSelection NHẬN TUPLE CÓ TỌA ĐỘ 💥
    private void HandleNumberSelection(Tuple<int, float, float> data)
    {
        var number = data.Item1;
        var startTop = data.Item2;
        var startLeft = data.Item3;

        // 1a. Kiểm tra nếu số đã quay xong/đang chọn, không làm gì
        if (DrawnNumbers.Contains(number) || CurrentSelectedNumbers.Contains(number))
        {
            return;
        }

        // 1b. TẠM DỪNG việc thêm vào CurrentSelectedNumbers.
        // Thay vào đó, chúng ta kích hoạt hiệu ứng bay.
        FlyingBallData = new BallFlyData
        {
            Number = number,
            StartTop = startTop,
            StartLeft = startLeft
        };

        // 💥 CHỈ CẦN GỌI StateHasChanged() để hiển thị FlyingBall 💥
        StateHasChanged();
    }

    // 💥 3. PHƯƠNG THỨC GỌI KHI BÓNG BAY XONG (từ FlyingBall.razor) 💥
    private void OnFlyAnimationComplete(int number)
    {
        // A. Thêm số vào danh sách hiển thị chính (Vùng 70%)
        // Đây là nơi số thực sự xuất hiện trên màn hình 70%
        if (!CurrentSelectedNumbers.Contains(number))
        {
            CurrentSelectedNumbers.Add(number);
        }

        // B. Xóa dữ liệu bay để FlyingBall.razor biến mất
        FlyingBallData = null;
        StateHasChanged();
    }

    // 4. Xử lý khi Popup đóng và ảnh chụp xong
    private void HandleDrawCompletion(string base64Image)
    {
        // 1. LƯU ẢNH VÀO LỊCH SỬ
        if (!string.IsNullOrEmpty(base64Image))
        {
            HistoryImages.Add(base64Image);
        }

        // 2. CHUYỂN SỐ ĐANG CHỌN SANG TRẠNG THÁI ĐÃ QUAY (Drawn)
        // Các số này sẽ tiếp tục hiển thị ở khung 70% (SelectedNumberDisplay)
        // và bị tô màu xám/disabled ở khung 20% (NumberPanel)
        foreach (var num in CurrentSelectedNumbers)
        {
            DrawnNumbers.Add(num);
        }

        // 3. KHÔNG CẦN CurrentSelectedNumbers.Clear() NỮA!
        // Nếu bạn xóa nó, các số sẽ biến mất khỏi khung 70%.
        // Giữ nguyên CurrentSelectedNumbers nếu bạn muốn nó tiếp tục hiển thị.
        // Tùy theo logic hiển thị, bạn có thể cần tạo một List mới để tránh thay đổi trực tiếp.

        // GIẢI PHÁP TỐT NHẤT: GIỮ NGUYÊN CurrentSelectedNumbers
        // và để HistoryAndInput.razor tự hiển thị ảnh lịch sử.

        // Nếu bạn muốn dọn dẹp để chuẩn bị cho lượt quay mới:
        // CurrentSelectedNumbers.Clear(); // <-- LƯU Ý: Nếu xóa, số sẽ biến mất ở khung 70%

        StateHasChanged();
    }
}